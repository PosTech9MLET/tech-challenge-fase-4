# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Ferramentas
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Segredos
.env

# Dados e artefatos (mantém a estrutura via .gitkeep)
data/raw/*
data/interim/*
data/processed/*
data/features/*
models/*
!**/.gitkeep
# Metadados do DVC (os dados ficam no cache/remote do DVC)
!data/**/*.dvc
!data/**/.gitignore
!models/.gitignore
# Métricas do treino ficam no Git para `dvc metrics diff`
!models/baseline_metrics.json

# MLflow
mlruns/
mlartifacts/
mlflow.db

# Figuras geradas (regeneráveis via scripts/generate_fairness_plots.py)
reports/figures/*.png

# SO / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Relatórios HTML gerados pelo Evidently
/reports/*.html

# Métricas operacionais geradas localmente
/reports/*.prom
