    {
      "id": "claim_7594bf4ec5be4558b6587661e26974e8",
      "statement": "The baseline model is a single scikit-learn Pipeline that takes the raw DataFrame: FunctionTransformer(build_features), a ColumnTransformer with an OrdinalEncoder mapping unknown/missing categories to NaN plus numeric passthrough, then an XGBClassifier with fixed XGB_PARAMS. Unknown production categories therefore do not break scoring.",
      "evidence": [
